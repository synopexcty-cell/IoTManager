# Ưu tiên: MongoDB → Google Sheets → mock (demo)

# --- MongoDB Atlas (khuyên dùng trên Vercel) ---
# Thêm /chamcong?retryWrites=true&w=majority vào URI
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/chamcong?retryWrites=true&w=majority

# --- Google Sheets (tuỳ chọn, bỏ qua nếu đã dùng Mongo) ---
# SHEETS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# SHEETS_API_SECRET=doi-thanh-chuoi-dai-ngau-nhien
